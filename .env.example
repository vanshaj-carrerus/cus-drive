# MongoDB connection string (optional for local use)
# Leave empty to store users/documents in ./data/store.json
# Example: mongodb+srv://USER:PASSWORD@cluster.mongodb.net/department-docs
MONGODB_URI=

# Secret used to sign session cookies (use a long random string)
AUTH_SECRET=

# First admin account — created automatically on first database connection
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Maximum upload size in megabytes
MAX_FILE_SIZE_MB=25

# Cloudinary — files are stored here; MongoDB keeps the returned link
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
